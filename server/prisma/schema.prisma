datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Enums supported as String literals in application layer


model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  name             String
  phone            String?
  role             String   @default("STUDENT") // STUDENT, FACULTY, COORDINATOR, ADMIN
  status           String   @default("ACTIVE")  // ACTIVE, PENDING, SUSPENDED
  emailVerified    Boolean  @default(true)
  avatarUrl        String?
  departmentId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  department            Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studentProfile        StudentProfile?
  facultyProfile        FacultyProfile?
  attendanceRecords     AttendanceRecord[]
  submissions           AssignmentSubmission[]
  eventRegistrations    EventRegistration[]
  clubMemberships       ClubMembership[]
  placementApplications PlacementApplication[]
  notifications         Notification[]
  activityLogs          ActivityLog[]
  createdEvents         Event[]                 @relation("CreatedEvents")
  createdAssignments    Assignment[]            @relation("CreatedAssignments")
  createdAnnouncements  Announcement[]          @relation("CreatedAnnouncements")
  createdPlacements     Placement[]             @relation("CreatedPlacements")
  managedClubs          Club[]                  @relation("ManagedClubs")
  attendanceSessions    AttendanceSession[]     @relation("FacultySessions")

  @@index([email])
  @@index([role])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  courses     Course[]
}

model Course {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  credits      Int      @default(3)
  departmentId String
  facultyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]

  @@index([code])
}

model StudentProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  rollNumber String   @unique
  batch      String
  semester   Int      @default(1)
  gpa        Float    @default(3.5)
  bio        String?
  resumeUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FacultyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  designation String
  officeHours String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceSession {
  id        String   @id @default(uuid())
  courseId  String
  facultyId String
  title     String
  date      String   // YYYY-MM-DD
  startTime String
  endTime   String
  qrCode    String?
  createdAt DateTime @default(now())

  course  Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty User               @relation("FacultySessions", fields: [facultyId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  status    String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  markedAt  DateTime @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Assignment {
  id            String   @id @default(uuid())
  courseId      String
  facultyId     String
  title         String
  description   String
  deadline      DateTime
  maxMarks      Int      @default(100)
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty     User                   @relation("CreatedAssignments", fields: [facultyId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  solutionUrl  String?
  githubUrl    String?
  submittedAt  DateTime @default(now())
  isLate       Boolean  @default(false)
  status       String   @default("SUBMITTED") // SUBMITTED, GRADED
  marks        Int?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Event {
  id                   String   @id @default(uuid())
  title                String
  bannerUrl            String?
  description          String
  venue                String
  eventDate            DateTime
  registrationDeadline DateTime
  capacity             Int      @default(100)
  category             String   @default("General")
  coordinatorId        String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coordinator   User                @relation("CreatedEvents", fields: [coordinatorId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  studentId    String
  qrPassCode   String   @unique
  status       String   @default("CONFIRMED") // CONFIRMED, CHECKED_IN, CANCELLED
  registeredAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
}

model Club {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  category      String
  logoUrl       String?
  coordinatorId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coordinator User             @relation("ManagedClubs", fields: [coordinatorId], references: [id], onDelete: Cascade)
  members     ClubMembership[]
}

model ClubMembership {
  id       String   @id @default(uuid())
  clubId   String
  studentId String
  role     String   @default("MEMBER") // MEMBER, LEAD, VOLUNTEER
  joinedAt DateTime @default(now())

  club    Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
}

model Placement {
  id             String   @id @default(uuid())
  company        String
  title          String
  description    String
  eligibilityGpa Float    @default(3.0)
  skills         String   // Comma separated
  ctc            String
  location       String
  deadline       DateTime
  createdById    String
  createdAt      DateTime @default(now())

  createdBy    User                   @relation("CreatedPlacements", fields: [createdById], references: [id], onDelete: Cascade)
  applications PlacementApplication[]
}

model PlacementApplication {
  id          String   @id @default(uuid())
  placementId String
  studentId   String
  resumeUrl   String?
  status      String   @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEW, SELECTED, REJECTED
  appliedAt   DateTime @default(now())

  placement Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([placementId, studentId])
}

model Announcement {
  id           String    @id @default(uuid())
  title        String
  content      String
  audienceRole String    @default("ALL") // ALL, STUDENT, FACULTY, COORDINATOR
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  expiresAt    DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  createdBy User @relation("CreatedAnnouncements", fields: [createdById], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, ASSIGNMENT, ATTENDANCE, EVENT, PLACEMENT, ANNOUNCEMENT
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  metadata   String?  // JSON stringified
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
